# TrustEscrow web app. Every value is public: it is compiled into the browser bundle.
#
# The trust anchors below (factory id, escrow WASM hash, network) come from this
# build, never from the backend. A compromised backend must not be able to point the
# app at a different factory or an unaudited escrow binary (ARCHITECTURE §2).

# Backend API (trustedescrow-backend). Its CORS_ORIGINS / PUBLIC_WEB_URL must allow this app.
NEXT_PUBLIC_API_URL=http://localhost:3000

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# From trustedescrow-contract deployments/testnet.env after scripts/deploy-testnet.sh.
NEXT_PUBLIC_FACTORY_CONTRACT_ID=
# The audited escrow WASM hash. The app refuses to fund an escrow running anything else.
# Must equal ESCROW_WASM_HASH in deployments/testnet.env (sha256 of trustescrow_escrow.wasm).
NEXT_PUBLIC_ESCROW_WASM_HASH=

# Settlement rails. tokenAddress must be on the factory allowlist.
# Testnet USDC SAC shown; verify before use.
NEXT_PUBLIC_RAILS=[{"id":"usdc-stellar","tokenAddress":"CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA","displaySymbol":"USDC","decimals":7}]

# Relying party for the code-vault passkey. Defaults to the page's hostname.
NEXT_PUBLIC_WEBAUTHN_RP_ID=
